# Example Environment Variables for Local Development
# Copy this file to .env and fill in the values

# Environment
NODE_ENV=development

# SQL Server Configuration
SQL_SERVER=your-sql-server.database.windows.net
SQL_DATABASE=employeedata
SQL_USER=your-username          # Used in development only
SQL_PASSWORD=your-password      # Used in development only

# Azure Key Vault
KEY_VAULT_NAME=your-keyvault-name

# Azure Storage Account for file share (SFTP)
STORAGE_ACCOUNT_NAME=yourstorageaccount
FILE_SHARE_NAME=sftpshare
STORAGE_ACCOUNT_KEY=your-storage-account-key  # Used in development only

# Schedule Configuration (cron format for every 15 minutes)
SCHEDULE_INTERVAL="*/15 * * * *"

# Application Insights (for monitoring in production)
# APPINSIGHTS_INSTRUMENTATIONKEY=your-instrumentation-key

# Logging Configuration
LOG_LEVEL=info
